# PostgreSQL persistence. A local mock repository powers the app UI and API
# when no database is configured, so the project still runs without this.
DATABASE_URL="postgresql://petcare:petcare@localhost:5432/petcare_hub?schema=public"

# Use a long, random value in deployed environments. This is reserved for
# production session/token integrations; never commit a real secret.
AUTH_SECRET="replace-with-a-long-random-production-secret"

# Local demo only: enables self-service veterinarian and service-provider
# workspaces. It is always ignored in production, where real credential and
# business verification must happen before professional access is granted.
ALLOW_SELF_SERVICE_PROFESSIONAL_ROLES="true"

# Optional service adapters. Leave blank for the built-in mock implementations.
OPENAI_API_KEY=""
EMAIL_FROM=""
SMTP_URL=""
STORAGE_BUCKET=""
